PORT=9999
DATABASE_URL=postgres://studio:studio@127.0.0.1:15432/studio
PUBLIC_BASE_URL=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app

# Human project identity — yarn ensure-project-identity writes config/project.identity.json
PROJECT_NAME=Vapi Studio Project
# Optional; defaults to a slugified PROJECT_NAME
PROJECT_SLUG=vapi-studio-project

POC_BRAIN_PROFILE=default
# Brain keys — only if you switch off MockBrain in src/app.module.ts
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=

# ─── Guidify ecosystem auth (optional — leave empty for OSS solo starter) ───
# Present Application credentials to tenants → JWT for analytics/etc.
VAPI_STUDIO_CLIENT_ID=
VAPI_STUDIO_CLIENT_SECRET=

# ─── Vapi (REQUIRED for yarn start claim / live voice) ───
# Phone: prefer Vapi-managed for starters; Twilio-imported BYOK for larger projects.
# Prefer Core for a first project (~$29/mo, 10 concurrent calls, 5 Vapi numbers).
# Free/usage-only (typically 4 concurrent, 1 number) is fine for a slow start — upgrade later.
# https://vapi.ai/pricing · framework doc: docs/getting-started/vapi-account.md (in @guidify-ai/vapi-studio)
VAPI_API_KEY=
# Assistant + phone this project CLAIMS (inbound SELECT on the phone).
POC_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_PHONE_NUMBER=
VAPI_PHONE_NUMBER_READABLE=
# Platform inventory slots (optional labels for make start / sync):
#   Slot 1 = primary customer project (e.g. Roofr)
#   Slot 2 = sample / landing outbound A/B
VAPI_CLAIM_ASSISTANT_SLOT=1
VAPI_CLAIM_PHONE_SLOT=1
# POC_ASSISTANT_ID_AB=
# Tool names: snake_case in this example. Live .env may keep dashboard camelCase.
VAPI_END_CALL_TOOL_NAME=end_call_tool
VAPI_TRANSFER_CALL_TOOL_NAME=transfer_call
VAPI_HANDOFF_TOOL_NAME=handoff
VAPI_TRANSFER_DESTINATION=
# VAPI_WEBHOOK_SECRET=

# ─── Twilio (OPTIONAL — larger BYOK + live SMS) ───
# Skip for simple Vapi-phone starters. Paid + verification when you add it.
# Trust Hub / +1 / ~$30 balance matter only for Twilio BYOK outbound.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_PHONE_NUMBER_SID=
TWILIO_SMS_DRY_RUN=1

LOG_DIR=logs
LOG_DAYS=14
